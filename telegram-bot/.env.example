# Ключ Telegram-бота от @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Адрес RAG-backend сайта — того же, что отвечает в чате на сайте.
# Хватит корня (добавим /api/chat) или укажите путь целиком.
# Локальный сервер: http://127.0.0.1:3456
BACKEND_URL=http://127.0.0.1:3456

# Авторизация в backend, если она там появится (Authorization: Bearer ...).
BACKEND_TOKEN=

# real — вопросы уходят в backend (тратит платные токены OpenAI).
# mock — заглушка: проверить кнопки, журнал диалогов и ошибки без токенов.
BACKEND_MODE=real

# Гибрид: true — простые вопросы (цены, часы, адрес, доставка, акции) бот
# закрывает сам из scenarios.py и не тратит токены; сомнительные и неизвестные
# темы уходят в RAG. false — весь текст, кроме кнопок, идёт в backend.
HYBRID_ROUTING=true

# --- Практика №2б: менеджер берёт диалог в Telegram --------------------------

# Чат менеджера: группа или второй аккаунт, где сидит менеджер.
# Команды /take, /release, /dialogs принимаем только там.
# Как узнать: напишите боту /id в нужном чате.
MANAGER_CHAT_ID=

# --- Практика №2а: письмо менеджеру ------------------------------------------

# Ссылка на очередь менеджера в письме. По умолчанию берётся из BACKEND_URL;
# укажите SITE_URL, если кабинет менеджера доступен по другому адресу.
# SITE_URL=http://localhost:3456

# true — письмо только печатается в консоль, ничего никуда не уходит.
# false — отправляем через SMTP, когда все настройки ниже проверены.
DRY_RUN=true

# Адрес менеджера — своя почта (руководитель дал согласие).
MANAGER_EMAIL=
# Отправитель. Обычно = SMTP_USER, можно не дублировать.
FROM_EMAIL=

# Подойдёт любая почта с паролем приложения — сервис роли не играет:
#   Gmail:     smtp.gmail.com, 587  (2FA -> «Пароль приложения»)
#   Яндекс:    smtp.yandex.ru, 587  (Яндекс ID -> «Пароли приложений»)
#   Mail.ru:   smtp.mail.ru, 587    (Настройки -> Безопасность -> Пароли)
#   Brevo:     smtp-relay.brevo.com, 587 (SMTP-ключ вместо пароля,
#              подтверждённый адрес отправителя)
SMTP_HOST=
SMTP_PORT=587
# true для implicit TLS (порт 465); пусто/false для STARTTLS на 587.
SMTP_SSL=
SMTP_USER=
SMTP_PASSWORD=
