# Скопируйте этот файл в .env и подставьте свои значения:
#   cp .env.example .env

# Ключ OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-you…-key

# Модель (опционально)
OPENAI_MODEL=gpt-4o-mini

# Порт сервера
PORT=3456

# Администратор личного кабинета (создаётся при первом запуске)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# База знаний: admin@ /account, файлы .txt и .md, векторы в data/rag.db.
# Модель эмбеддингов та же, что и у чат-бота, — OPENAI_API_KEY общий.
EMBEDDING_MODEL=text-embedding-3-small

# Сколько фрагментов попадает в промпт (по умолчанию 4)
RAG_TOP_K=4

# Ниже этого косинусного сходства бот отвечает «не знаю» и не зовёт модель
RAG_MIN_SIMILARITY=0.3

# Длина фрагмента и его перекрытие в знаках
CHUNK_SIZE=600
CHUNK_OVERLAP=100
